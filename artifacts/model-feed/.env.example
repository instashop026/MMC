# Browser-safe values. Supabase publishable/anon keys are designed for browsers;
# database access is enforced by Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Set this in Netlify site environment variables.
ZEROSTORAGE_API_KEY=

# Optional server aliases for the Netlify Function. If omitted, the function
# reads the VITE_ Supabase URL and publishable key above.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=