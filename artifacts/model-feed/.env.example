# Browser-safe values for local Vite development. The Vite config also accepts
# SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY from the Replit/Netlify environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Set this in Netlify site environment variables.
ZEROSTORAGE_API_KEY=

# Optional server aliases for the Netlify Function. If omitted, the function
# reads the VITE_ Supabase URL and publishable key above.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=